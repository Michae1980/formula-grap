            "cited_formula_ids": [
              "physics.mech.pressure_def",
              "physics.mech.gravity"
            ]
          },
          {
            "step": 2,
            "latex": "= \\frac{\\rho V g}{S} = \\frac{\\rho (S h) g}{S} = \\rho g h",
            "note": "代入 m = ρV 与液柱体积 V = Sh，约去底面积 S",
