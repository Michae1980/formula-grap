              "physics.mech.volume_prism"
            ]
          }
        ],
        "L3_detailed": [
          {
            "step": 1,
            "latex": "F = G = m g",
            "note": "取深度 h 处面积为 S 的水平液片，其上方液柱竖直静止，故压力等于重力",
            "cited_formula_ids": [
              "physics.mech.gravity"
            ]
          },
          {
            "step": 2,
            "latex": "m = \\rho V = \\rho S h",
            "note": "由密度公式与直柱体体积公式表示液柱质量",
            "cited_formula_ids": [
              "physics.mech.density",
              "physics.mech.volume_prism"
            ]
          },
          {
            "step": 3,
            "latex": "p = \\frac{F}{S} = \\frac{\\rho S h g}{S} = \\rho g h",
            "note": "代入压强定义式约去 S，表明液体压强与容器形状和底面积无关，量纲 [kg/m³]·[m/s²]·[m] = [Pa]",
            "cited_formula_ids": [
              "physics.mech.pressure_def"
            ],
