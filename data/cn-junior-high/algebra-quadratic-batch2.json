  "derivations": [
    {
      "id": "deriv.alg.dist_to_diff_sq",
      "from_formula_ids": ["math.alg.distributive"],
      "to_formula_id": "math.alg.diff_of_squares",
      "relation_type": "special_case_of",
      "dependency_site": "proof_level",
      "inference_rules": ["specialization", "cancel_opposite_terms"],
      "bidirectional": false,
      "levels": {
        "L1_summary": "在分配律中令 c = a、d = -b，展开后交叉项 +ab 与 -ab 抵消即得平方差公式。",
        "L2_standard": [
          { "step": 1, "latex": "(a + b)(a - b) = a^2 - ab + ba - b^2", "note": "套用多项式乘法分配律展开", "cited_formula_ids": ["math.alg.distributive"] },
          { "step": 2, "latex": "= a^2 - b^2", "note": "交叉项 -ab 与 +ab 互为相反数抵消", "cited_formula_ids": [] }
