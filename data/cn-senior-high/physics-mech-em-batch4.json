    {
      "id": "physics.dyn.newton2",
      "node_kind": "law",
      "name": "牛顿第二定律",
      "aliases": [
        "动力学基本方程"
      ],
      "latex": "F_{\\text{合}} = m a",
      "statement": "物体的加速度与所受合外力成正比、与质量成反比，且加速度方向永远与合外力方向瞬时一致。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "kinematics_newton"
        ]
      },
      "variables": [
        {
          "symbol": "F_{\\text{合}}",
          "name": "合外力",
          "math_type": "scalar",
          "domain": "\\mathbb{R}",
          "quantity_kind": "force",
          "dimension": "M L T^{-2}",
          "si_unit": "N"
        },
        {
          "symbol": "m",
          "name": "惯性质量",
          "math_type": "scalar",
          "domain": "(0, +\\infty)",
          "quantity_kind": "mass",
          "dimension": "M",
          "si_unit": "kg"
        }
      ],
      "conditions": [
        "宏观低速（v ≪ c）惯性参考系下成立"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教版高中物理必修一 4.3",
        "sympy_verified": true
      }
    },
    {
      "id": "physics.dyn.centripetal",
      "node_kind": "formula",
      "name": "向心力公式",
      "aliases": [
        "匀速圆周运动动力学方程"
      ],
      "latex": "F_n = m \\frac{v^2}{r} = m \\omega^2 r",
      "statement": "维持质点以速率 v、半径 r 做圆周运动所需的指向圆心的合外力，是牛顿第二定律在法向方向的应用。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "kinematics_newton"
        ]
      },
      "variables": [
        {
          "symbol": "F_n",
          "name": "向心力",
          "math_type": "scalar",
          "domain": "[0, +\\infty)",
          "quantity_kind": "force",
          "dimension": "M L T^{-2}",
          "si_unit": "N"
        },
        {
          "symbol": "r",
          "name": "轨道半径",
          "math_type": "scalar",
          "domain": "(0, +\\infty)",
          "quantity_kind": "length",
          "dimension": "L",
          "si_unit": "m"
        },
        {
          "symbol": "\\omega",
          "name": "角速度",
          "math_type": "scalar",
          "domain": "[0, +\\infty)",
          "quantity_kind": "angular_velocity",
          "dimension": "T^{-1}",
          "si_unit": "rad/s"
        }
      ],
      "conditions": [
        "向心力是按效果命名的合力，受力分析时切勿多画一个独立向心力"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教版高中物理必修二 6.2",
        "sympy_verified": true
      }
    },
    {
      "id": "physics.dyn.gravitation",
      "node_kind": "law",
      "name": "万有引力定律",
      "aliases": [
        "牛顿引力公式"
      ],
      "latex": "F = G \\frac{M m}{r^2}",
      "statement": "自然界任意两个质点间都存在相互吸引力，大小与质量乘积成正比、与质心距离平方成反比。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "kinematics_newton"
        ]
      },
      "variables": [
        {
          "symbol": "G",
          "name": "万有引力常量",
          "math_type": "constant",
          "domain": "6.67\\times 10^{-11}",
          "quantity_kind": "gravitational_constant",
          "dimension": "M^{-1} L^3 T^{-2}",
          "si_unit": "N·m²/kg²"
        }
      ],
      "conditions": [
        "适用于两质点或均匀球体（r 为两球心距离）"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教版高中物理必修二 7.2",
        "sympy_verified": true
      }
    },
    {
      "id": "physics.dyn.first_cosmic",
      "node_kind": "formula",
      "name": "第一宇宙速度（环绕速度）",
      "aliases": [
        "近地卫星最小发射速度"
      ],
      "latex": "v_1 = \\sqrt{\\frac{G M}{R}} = \\sqrt{g R}",
      "statement": "人造卫星紧贴星球表面做匀速圆周运动的速度，对地球约为 7.9 km/s，是发射卫星的最小速度与环绕的最大速度。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "kinematics_newton"
        ]
      },
      "variables": [
        {
          "symbol": "R",
          "name": "中心天体半径",
          "math_type": "constant",
          "domain": "(0, +\\infty)",
          "quantity_kind": "length",
          "dimension": "L",
          "si_unit": "m"
        }
      ],
      "conditions": [
        "忽略星球自转与大气阻力，万有引力全部提供向心力"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教版高中物理必修二 7.4",
        "sympy_verified": true
      }
    },
    {
      "id": "physics.eng.kinetic_theorem",
      "node_kind": "theorem",
      "name": "动能定理",
      "aliases": [
        "合外力做功与动能变化关系"
      ],
      "latex": "W_{\\text{合}} = \\Delta E_k = \\frac{1}{2} m v^2 - \\frac{1}{2} m v_0^2",
      "statement": "合外力对物体所做的总功等于物体动能的增量，突破了恒力与直线限制，对变力与曲线运动同样成立。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "momentum_energy"
        ]
      },
      "variables": [
        {
          "symbol": "E_k",
          "name": "动能",
          "math_type": "scalar",
          "domain": "[0, +\\infty)",
          "quantity_kind": "energy",
          "dimension": "M L^2 T^{-2}",
          "si_unit": "J"
        }
      ],
      "conditions": [
        "适用于恒力、变力、直线与曲线运动，只需关注初末状态"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教版高中物理必修二 8.3",
        "sympy_verified": true
      }
    },
    {
      "id": "physics.eng.mech_conservation",
      "node_kind": "law",
      "name": "机械能守恒定律",
      "aliases": [
        "动能与势能转化守恒"
      ],
      "latex": "E_{k1} + E_{p1} = E_{k2} + E_{p2}",
      "statement": "当系统内只有重力或弹力做功时，动能与势能相互转化但机械能总量保持不变。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "momentum_energy"
        ]
      },
      "variables": [
        {
          "symbol": "E_p",
          "name": "势能（重力势能 mgh 或弹性势能 ½kx²）",
          "math_type": "scalar",
          "domain": "\\mathbb{R}",
          "quantity_kind": "energy",
          "dimension": "M L^2 T^{-2}",
          "si_unit": "J"
        }
      ],
      "conditions": [
        "除重力与系统内弹力外，其他外力与非保守内力（如摩擦力）做功之和为零"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教版高中物理必修二 8.4",
        "sympy_verified": true
      }
    },
    {
      "id": "physics.mom.impulse_theorem",
      "node_kind": "theorem",
      "name": "动量定理",
      "aliases": [
        "冲量与动量变化关系"
      ],
      "latex": "I = F_{\\text{合}} \\Delta t = \\Delta p = m v - m v_0",
      "statement": "物体所受合外力的冲量等于其动量的变化量，揭示力在时间上的累积效应（缓冲减震的物理原理）。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "momentum_energy"
        ]
      },
      "variables": [
        {
          "symbol": "I, p",
          "name": "冲量与动量",
          "math_type": "scalar",
          "domain": "\\mathbb{R}",
          "quantity_kind": "momentum",
          "dimension": "M L T^{-1}",
          "si_unit": "kg·m/s"
        }
      ],
      "conditions": [
        "矢量式，计算一维碰撞时必须规定正方向并注意反弹速度的负号"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教版高中物理选择性必修一 1.2",
        "sympy_verified": true
