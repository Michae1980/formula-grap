      "name": "闭合电路欧姆定律",
      "aliases": [
        "全电路欧姆定律"
      ],
      "latex": "I = \\frac{E}{R + r},\\quad U_{\\text{路}} = E - I r",
      "statement": "考虑电源电动势 E 与内阻 r 后，闭合回路总电流等于电动势除以总电阻，路端电压随外电流增大线性下降。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
