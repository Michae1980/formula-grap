  "formulas": [
    {
      "id": "physics.kin.vel_time",
      "node_kind": "formula",
      "name": "匀变速直线运动速度公式",
      "aliases": [
        "v-t 公式"
      ],
      "latex": "v = v_0 + a t",
      "statement": "加速度恒定时，末速度等于初速度加上加速度与时间的乘积，v-t 图像是一条斜率为 a 的直线。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "kinematics_newton"
        ]
      },
      "variables": [
        {
          "symbol": "v, v_0",
          "name": "末速度与初速度",
          "math_type": "scalar",
          "domain": "\\mathbb{R}",
          "quantity_kind": "velocity",
          "dimension": "L T^{-1}",
          "si_unit": "m/s"
        },
        {
          "symbol": "a",
          "name": "恒定加速度",
          "math_type": "scalar",
          "domain": "\\mathbb{R}",
          "quantity_kind": "acceleration",
          "dimension": "L T^{-2}",
          "si_unit": "m/s²"
        },
        {
          "symbol": "t",
          "name": "时间",
          "math_type": "scalar",
          "domain": "[0, +\\infty)",
          "quantity_kind": "time",
          "dimension": "T",
          "si_unit": "s"
        }
      ],
      "conditions": [
        "仅适用于匀变速直线运动（a 恒定）；需先规定正方向并代入矢量正负号"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教版高中物理必修一 2.2",
        "sympy_verified": true
      }
    },
    {
      "id": "physics.kin.disp_time",
      "node_kind": "formula",
      "name": "匀变速直线运动位移公式",
      "aliases": [
        "x-t 公式"
      ],
      "latex": "x = v_0 t + \\frac{1}{2} a t^2",
      "statement": "匀变速直线运动的位移等于 v-t 图像梯形面积，由匀速部分 v0t 与加速增量部分 ½at² 叠加而成。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "kinematics_newton"
        ]
      },
      "variables": [
        {
          "symbol": "x",
          "name": "位移",
          "math_type": "scalar",
          "domain": "\\mathbb{R}",
          "quantity_kind": "length",
          "dimension": "L",
          "si_unit": "m"
        }
      ],
      "conditions": [
        "匀变速直线运动；自由落体时 v0 = 0, a = g 化为 h = ½gt²"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教版高中物理必修一 2.3",
        "sympy_verified": true
      }
    },
    {
      "id": "physics.kin.vel_disp",
      "node_kind": "formula",
      "name": "匀变速速度-位移公式",
      "aliases": [
        "不含时间 t 推论"
      ],
      "latex": "v^2 - v_0^2 = 2 a x",
      "statement": "消去时间 t 后直接建立初末速度平方差与位移的定量关系，是推导动能定理的运动学起点。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
