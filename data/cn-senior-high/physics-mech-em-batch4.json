    {
      "id": "physics.mom.conservation",
      "node_kind": "law",
      "name": "动量守恒定律",
      "aliases": [
        "碰撞与反冲基本定律"
      ],
      "latex": "m_1 v_1 + m_2 v_2 = m_1 v_1' + m_2 v_2'",
      "statement": "若系统不受外力或所受合外力为零，则系统总动量在相互作用前后保持恒定，适用于宏观碰撞至微观粒子。",
      "taxonomy": {
        "disciplines": [
          "physics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "momentum_energy"
        ]
      },
      "variables": [
        {
          "symbol": "m_1, m_2",
          "name": "两物体质量",
          "math_type": "scalar",
          "domain": "(0, +\\infty)",
          "quantity_kind": "mass",
          "dimension": "M",
          "si_unit": "kg"
        }
      ],
      "conditions": [
