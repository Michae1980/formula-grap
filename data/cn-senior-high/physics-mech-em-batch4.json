          "math_type": "scalar",
          "domain": "\\mathbb{R}",
          "quantity_kind": null,
          "dimension": "L^2 T^{-2}",
          "si_unit": "m²/s²"
        }
      ],
      "conditions": [
        "匀变速直线运动"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教版高中物理必修一 2.3",
        "sympy_verified": true
      }
