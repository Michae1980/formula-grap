        "L2_standard": [
          { "step": 1, "latex": "(a + b)^n = \\underbrace{(a+b)(a+b)\\cdots(a+b)}_{n\\text{ 个}}", "note": "展开后每一项形如 a^{n-k} b^k", "cited_formula_ids": ["math.seq.geom_term"] },
          { "step": 2, "latex": "(a + b)^n = \\sum_{k=0}^{n} \\binom{n}{k} a^{n-k} b^k", "note": "从 n 个因式中选 k 个取 b 共有 C(n,k) 种方式", "cited_formula_ids": [] }
        ],
        "L3_detailed": [
          { "step": 1, "latex": "(1 + 1)^n = \\sum_{k=0}^{n} \\binom{n}{k} = 2^n", "note": "令 a=b=1 立得组合数总和为等比数列 2^n，令 a=1, b=-1 得奇偶项系数和相等", "cited_formula_ids": ["math.seq.geom_term"], "pitfall": "区分“第 k+1 项的二项式系数 C(n,k)”与“该项的完整系数（含 a、b 的数字因子）”。" }
        ]
      }
    },
    {
