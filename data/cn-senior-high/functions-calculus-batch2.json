        "L2_standard": [
          {
            "step": 1,
            "latex": "f'(x) > 0 \\text{ on } (a,b) \\implies \\text{任意 } x_1 < x_2,\\ f(x_2) > f(x_1)",
            "note": "区间内导数恒正推出严格递增（大学微积分中由拉格朗日中值定理严格证明）",
            "cited_formula_ids": [
              "math.calc.derivative_def"
            ]
          }
        ],
        "L3_detailed": [
          {
            "step": 1,
            "latex": "f'(x) > 0 \\implies f(x) \\text{ 递增},\\quad f'(x) < 0 \\implies f(x) \\text{ 递减}",
            "note": "允许在孤立点处导数为 0（如 y = x³ 在 x = 0），仍保持整体单调递增",
            "cited_formula_ids": [
              "math.calc.derivative_def"
            ],
            "pitfall": "若已知函数在区间上单调递增求参数范围，转化条件应写 f'(x) ≥ 0（含等号），再检验是否恒为常函数。"
          }
        ]
      }
