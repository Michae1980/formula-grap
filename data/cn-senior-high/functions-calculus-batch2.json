            ]
          },
          {
            "step": 2,
            "latex": "\\frac{a^2+b^2}{2} - \\left(\\frac{a+b}{2}\\right)^2 = \\frac{(a-b)^2}{4} \\ge 0 \\implies \\frac{a+b}{2} \\le \\sqrt{\\frac{a^2+b^2}{2}}",
