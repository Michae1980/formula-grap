          "domain": "(0, +\\infty)",
          "quantity_kind": null,
          "dimension": null,
          "si_unit": null
        }
      ],
      "conditions": [
        "一正（a, b > 0）、二定（和或积为定值）、三相等（当且仅当 a = b 时取等）"
      ],
      "review": {
        "status": "human_verified",
        "source": "人教A版必修第一册 2.2",
        "sympy_verified": true
      }
