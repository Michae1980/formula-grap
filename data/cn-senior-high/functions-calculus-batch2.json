      "id": "math.alg.am_gm",
      "node_kind": "inequality",
      "name": "基本不等式（均值不等式）",
      "aliases": [
        "AM-GM 不等式"
      ],
      "latex": "\\frac{a + b}{2} \\ge \\sqrt{ab}",
      "statement": "两个正实数的算术平均数不小于它们的几何平均数，当且仅当两数相等时取等号。",
      "taxonomy": {
        "disciplines": [
          "mathematics"
        ],
        "education_stages": [
          "senior_high"
        ],
        "topics": [
          "inequalities",
          "inequalities_props"
        ]
      },
      "variables": [
