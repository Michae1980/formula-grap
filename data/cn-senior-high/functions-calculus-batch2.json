            ]
          },
          {
            "step": 2,
            "latex": "f(x) = x + \\frac{k}{x}\\ (x,k>0) \\implies f'(x) = 1 - \\frac{k}{x^2} = 0 \\implies x = \\sqrt{k}",
            "note": "与基本不等式 x + k/x ≥ 2√k 的取等条件 x = √k 完全吻合",
            "cited_formula_ids": [
              "math.alg.am_gm"
            ]
          }
        ],
        "L3_detailed": [
          {
            "step": 1,
            "latex": "f'(x_0) = 0",
            "note": "左正右负为极大值点，左负右正为极小值点；若两侧同号则非极值点",
