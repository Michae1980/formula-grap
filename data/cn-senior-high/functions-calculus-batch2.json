        "L2_standard": [
          {
            "step": 1,
            "latex": "M = a^m,\\ N = a^n \\iff m = \\log_a M,\\ n = \\log_a N",
            "note": "由指对互化定义设出指数",
            "cited_formula_ids": [
              "math.func.log_def"
            ]
          },
          {
            "step": 2,
            "latex": "MN = a^m \\cdot a^n = a^{m+n} \\implies \\log_a(MN) = m + n = \\log_a M + \\log_a N",
            "note": "应用指数运算律后再转回对数",
            "cited_formula_ids": [
              "math.func.exp_rules",
              "math.func.log_def"
            ]
          }
        ],
        "L3_detailed": [
          {
            "step": 1,
            "latex": "M = a^m,\\ N = a^n \\implies MN = a^{m+n}",
            "note": "指数运算把乘积转化为指数之和",
            "cited_formula_ids": [
              "math.func.exp_rules",
              "math.func.log_def"
            ]
          },
          {
            "step": 2,
            "latex": "\\log_a(MN) = m + n = \\log_a M + \\log_a N",
            "note": "同样令 M^k = (a^m)^k = a^(km) 即证 log_a(M^k) = k log_a M",
            "cited_formula_ids": [
              "math.func.log_def"
            ],
            "pitfall": "切勿混淆为 log_a(M+N) = log_a M + log_a N，真数相加不能拆开。"
          }
        ]
      }
    },
    {
