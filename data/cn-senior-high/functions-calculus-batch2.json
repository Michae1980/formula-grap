      "levels": {
        "L1_summary": "对正整数次幂将 (x+Δx)^n 用二项式展开，消去 x^n 并约去 Δx，令 Δx → 0 仅保留首项 nx^(n-1)。",
        "L2_standard": [
          {
            "step": 1,
            "latex": "\\frac{(x+\\Delta x)^n - x^n}{\\Delta x} = n x^{n-1} + \\binom{n}{2} x^{n-2}\\Delta x + \\cdots + (\\Delta x)^{n-1}",
            "note": "二项式展开并约去 Δx",
            "cited_formula_ids": [
              "math.calc.derivative_def"
            ]
          },
          {
            "step": 2,
            "latex": "(x^n)' = \\lim_{\\Delta x \\to 0} \\frac{(x+\\Delta x)^n - x^n}{\\Delta x} = n x^{n-1}",
            "note": "令 Δx → 0，含 Δx 的高阶项全部归零（可进一步推广至实指数 α）",
            "cited_formula_ids": []
          }
        ],
        "L3_detailed": [
          {
            "step": 1,
            "latex": "(x^\\alpha)' = \\alpha x^{\\alpha - 1}",
            "note": "实指数 α 情形可写为 x^α = e^(α ln x) 后用链式法则证明，结论形式完全统一",
            "cited_formula_ids": [
              "math.calc.derivative_def"
            ],
            "pitfall": "根式与分式幂先化为分数/负指数再求导，如 (1/x)' = (x⁻¹)' = -x⁻² = -1/x²。"
          }
        ]
      }
