      "levels": {
        "L1_summary": "设 x = log_a b 即 a^x = b，两边同时取以 c 为底的对数并用幂的对数法则解出 x。",
        "L2_standard": [
          {
            "step": 1,
            "latex": "x = \\log_a b \\iff a^x = b",
            "note": "化为指数式",
            "cited_formula_ids": [
              "math.func.log_def"
            ]
          },
          {
            "step": 2,
            "latex": "\\log_c(a^x) = \\log_c b \\implies x\\log_c a = \\log_c b \\implies x = \\frac{\\log_c b}{\\log_c a}",
            "note": "两边同取底数 c 的对数并解出 x",
            "cited_formula_ids": [
              "math.func.log_rules"
            ]
          }
        ],
        "L3_detailed": [
          {
            "step": 1,
            "latex": "a^x = b \\implies \\log_c(a^x) = \\log_c b",
            "note": "因 c > 0, c ≠ 1 且两边真数均为正，取对数保持等价",
            "cited_formula_ids": [
              "math.func.log_def"
            ]
          },
          {
            "step": 2,
            "latex": "x = \\frac{\\log_c b}{\\log_c a}",
            "note": "因 a ≠ 1 故 log_c a ≠ 0，可直接除以 log_c a；特例得 log_a b · log_b a = 1",
            "cited_formula_ids": [
              "math.func.log_rules"
            ],
            "pitfall": "换底时记住“真数在上、底数在下”，常用自然对数化为 ln b / ln a。"
          }
        ]
      }
    },
