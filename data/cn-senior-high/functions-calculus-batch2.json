        "L2_standard": [
          {
            "step": 1,
            "latex": "(e^x)' = \\lim_{\\Delta x \\to 0} \\frac{e^{x+\\Delta x} - e^x}{\\Delta x} = e^x \\lim_{\\Delta x \\to 0} \\frac{e^{\\Delta x} - 1}{\\Delta x} = e^x",
            "note": "提出 e^x 并使用自然底数极限性质",
            "cited_formula_ids": [
              "math.calc.derivative_def",
              "math.func.exp_rules"
            ]
          },
          {
            "step": 2,
            "latex": "(\\ln x)' = \\lim_{\\Delta x \\to 0} \\frac{\\ln(x+\\Delta x) - \\ln x}{\\Delta x} = \\frac{1}{x} \\lim_{u \\to 0} \\frac{\\ln(1+u)}{u} = \\frac{1}{x}",
            "note": "令 u = Δx/x 化简对数差商极限",
            "cited_formula_ids": [
              "math.calc.derivative_def",
              "math.func.log_rules"
            ]
          }
        ],
        "L3_detailed": [
          {
            "step": 1,
            "latex": "(e^x)' = e^x,\\quad (\\ln x)' = \\frac{1}{x}",
            "note": "自然底数 e 的核心意义即让指数函数导数系数恰好为 1",
            "cited_formula_ids": [
              "math.calc.derivative_def",
              "math.func.exp_rules"
            ],
            "pitfall": "注意对数导数 1/x 的定义域仍继承自原函数 ln x，要求 x > 0。"
