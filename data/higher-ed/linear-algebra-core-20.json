  "formulas": [
    {
      "id": "linalg.vec.dot_product",
      "name": "向量内积（点积）公式",
      "aliases": ["数量积", "点乘公式"],
      "latex": "\\mathbf{u} \\cdot \\mathbf{v} = \\sum_{i=1}^{n} u_i v_i = \\|\\mathbf{u}\\|\\|\\mathbf{v}\\|\\cos\\theta",
      "statement": "两个同维向量的内积等于对应分量乘积之和，几何上等于两向量模长与夹角余弦的乘积，用于度量相似度与正交性。",
      "taxonomy": {
        "disciplines": ["mathematics"],
        "education_stages": ["senior_high", "undergraduate"],
        "topics": ["vectors_inner_product"]
      },
      "variables": [
        { "symbol": "\\mathbf{u}, \\mathbf{v}", "name": "n 维实向量", "math_type": "vector", "domain": "\\mathbb{R}^n", "quantity_kind": null, "dimension": null, "si_unit": null },
        { "symbol": "\\theta", "name": "两向量夹角", "math_type": "angle", "domain": "[0, \\pi]", "quantity_kind": "plane_angle", "dimension": "1", "si_unit": "rad" }
      ],
      "conditions": ["两向量维度相同；当 u·v = 0 时称两向量正交（垂直）"],
      "review": { "status": "human_verified", "source": "同济线性代数 5.1", "sympy_verified": true }
    },
    {
      "id": "linalg.vec.norm",
      "name": "向量欧几里得范数（L2 模长）",
      "aliases": ["向量长度公式"],
      "latex": "\\|\\mathbf{v}\\|_2 = \\sqrt{\\mathbf{v}^\\top \\mathbf{v}} = \\sqrt{\\sum_{i=1}^{n} v_i^2}",
      "statement": "由向量自身内积开平方定义的欧氏长度，是勾股定理向 n 维空间的直接推广。",
      "taxonomy": {
        "disciplines": ["mathematics"],
        "education_stages": ["senior_high", "undergraduate"],
        "topics": ["vectors_inner_product"]
      },
      "variables": [
        { "symbol": "\\|\\mathbf{v}\\|_2", "name": "向量欧氏范数", "math_type": "scalar", "domain": "[0, +\\infty)", "quantity_kind": null, "dimension": null, "si_unit": null }
      ],
      "conditions": ["非负性：‖v‖ ≥ 0，且 ‖v‖ = 0 当且仅当 v = 0"],
      "review": { "status": "human_verified", "source": "同济线性代数 5.1", "sympy_verified": true }
    },
    {
      "id": "linalg.vec.cauchy_schwarz",
      "name": "柯西-施瓦茨不等式",
      "aliases": ["Cauchy-Schwarz 不等式"],
      "latex": "|\\mathbf{u} \\cdot \\mathbf{v}| \\le \\|\\mathbf{u}\\|\\|\\mathbf{v}\\|",
      "statement": "任意两向量内积的绝对值不超过各自模长的乘积，是高维空间夹角定义、三角不等式与统计相关系数有界性的根基。",
      "taxonomy": {
        "disciplines": ["mathematics"],
        "education_stages": ["undergraduate"],
        "topics": ["vectors_inner_product"]
      },
      "variables": [
        { "symbol": "\\mathbf{u}, \\mathbf{v}", "name": "内积空间向量", "math_type": "vector", "domain": "\\mathbb{R}^n", "quantity_kind": null, "dimension": null, "si_unit": null }
      ],
      "conditions": ["等号成立当且仅当 u 与 v 线性相关（共线）"],
      "review": { "status": "human_verified", "source": "同济线性代数 5.1", "sympy_verified": true }
    },
    {
      "id": "linalg.vec.projection",
      "name": "向量正交投影公式",
      "aliases": ["一维子空间投影"],
      "latex": "\\text{proj}_{\\mathbf{u}}(\\mathbf{v}) = \\frac{\\mathbf{u} \\cdot \\mathbf{v}}{\\|\\mathbf{u}\\|^2}\\mathbf{u}",
      "statement": "将向量 v 沿非零向量 u 方向作垂足分解，得到 v 在直线 span(u) 上的最佳逼近分量。",
      "taxonomy": {
        "disciplines": ["mathematics"],
        "education_stages": ["undergraduate"],
        "topics": ["vectors_inner_product"]
      },
      "variables": [
        { "symbol": "\\mathbf{u}", "name": "投影目标方向非零向量", "math_type": "vector", "domain": "\\mathbb{R}^n \\setminus \\{\\mathbf{0}\\}", "quantity_kind": null, "dimension": null, "si_unit": null }
      ],
      "conditions": ["u ≠ 0；误差向量 v - proj_u(v) 与 u 严格正交"],
      "review": { "status": "human_verified", "source": "Gilbert Strang 线性代数 4.2", "sympy_verified": true }
    },
    {
      "id": "linalg.vec.gram_schmidt",
      "name": "施密特正交化公式（Gram-Schmidt）",
      "aliases": ["标准正交基构造"],
      "latex": "\\mathbf{u}_k = \\mathbf{v}_k - \\sum_{j=1}^{k-1} \\frac{\\mathbf{u}_j \\cdot \\mathbf{v}_k}{\\mathbf{u}_j \\cdot \\mathbf{u}_j}\\mathbf{u}_j",
      "statement": "依次从当前向量减去它在已构造正交基上的全部投影，把任意线性无关向量组转化为等价的正交向量组（QR 分解核心）。",
      "taxonomy": {
        "disciplines": ["mathematics"],
        "education_stages": ["undergraduate"],
        "topics": ["vectors_inner_product"]
      },
      "variables": [
        { "symbol": "\\mathbf{v}_k, \\mathbf{u}_k", "name": "原始基与正交化后基向量", "math_type": "vector", "domain": "\\mathbb{R}^n", "quantity_kind": null, "dimension": null, "si_unit": null }
      ],
      "conditions": ["初始向量组 v1, ..., vm 线性无关；最后再逐个除以自身模长即得标准正交基"],
      "review": { "status": "human_verified", "source": "同济线性代数 5.1", "sympy_verified": true }
    },
    {
      "id": "linalg.mat.multiply",
      "name": "矩阵乘法定义式",
      "aliases": ["线性变换复合"],
      "latex": "(AB)_{ij} = \\sum_{k=1}^{n} A_{ik} B_{kj}",
      "statement": "乘积矩阵的第 (i, j) 元等于左矩阵第 i 行与右矩阵第 j 列的内积，本质上对应两个线性变换的顺序复合。",
      "taxonomy": {
        "disciplines": ["mathematics"],
        "education_stages": ["undergraduate"],
        "topics": ["matrices_systems"]
      },
      "variables": [
        { "symbol": "A, B", "name": "m×n 与 n×p 矩阵", "math_type": "matrix", "domain": "\\mathbb{R}^{m\\times n},\\ \\mathbb{R}^{n\\times p}", "quantity_kind": null, "dimension": null, "si_unit": null }
      ],
      "conditions": ["左矩阵列数必须等于右矩阵行数；矩阵乘法满足结合律与分配律，一般不满足交换律"],
      "review": { "status": "human_verified", "source": "同济线性代数 2.2", "sympy_verified": true }
    },
    {
      "id": "linalg.mat.transpose",
      "name": "矩阵转置与反序乘积法则",
      "aliases": ["穿脱鞋转置法则"],
      "latex": "(AB)^\\top = B^\\top A^\\top",
      "statement": "矩阵乘积的转置等于各因子转置后的反序乘积，广泛用于对称阵构造、二次型与正规方程推导。",
      "taxonomy": {
        "disciplines": ["mathematics"],
        "education_stages": ["undergraduate"],
        "topics": ["matrices_systems"]
      },
      "variables": [
        { "symbol": "A^\\top", "name": "矩阵 A 的转置", "math_type": "matrix", "domain": "\\mathbb{R}^{n\\times m}", "quantity_kind": null, "dimension": null, "si_unit": null }
      ],
      "conditions": ["AB 有意义（A 的列数等于 B 的行数）"],
      "review": { "status": "human_verified", "source": "同济线性代数 2.2", "sympy_verified": true }
    },
    {
      "id": "linalg.mat.inverse",
      "name": "可逆矩阵与反序求逆法则",
      "aliases": ["逆矩阵定义与乘积逆"],
      "latex": "A A^{-1} = A^{-1} A = I,\\quad (AB)^{-1} = B^{-1} A^{-1}",
      "statement": "若方阵 A 存在逆矩阵使乘积为单位阵 I，则该线性变换可完全还原；两个可逆阵乘积的逆等于各自逆阵的反序相乘。",
      "taxonomy": {
        "disciplines": ["mathematics"],
        "education_stages": ["undergraduate"],
        "topics": ["matrices_systems"]
      },
      "variables": [
        { "symbol": "A^{-1}", "name": "n 阶可逆矩阵的逆", "math_type": "matrix", "domain": "GL(n, \\mathbb{R})", "quantity_kind": null, "dimension": null, "si_unit": null }
      ],
      "conditions": ["A、B 均为同阶非奇异方阵（det ≠ 0 且满秩）"],
      "review": { "status": "human_verified", "source": "同济线性代数 2.3", "sympy_verified": true }
    },
    {
      "id": "linalg.mat.rank_nullity",
      "name": "秩-零度定理（维数公式）",
      "aliases": ["线性方程组解空间维数定理"],
      "latex": "\\text{rank}(A) + \\text{nullity}(A) = n",
      "statement": "m×n 矩阵的列空间维数（秩）与零空间维数（自由变量个数）之和恒等于列数 n，揭示线性映射的维数守恒。",
      "taxonomy": {
        "disciplines": ["mathematics"],
        "education_stages": ["undergraduate"],
        "topics": ["matrices_systems"]
      },
      "variables": [
        { "symbol": "\\text{rank}(A)", "name": "矩阵的秩（主元个数）", "math_type": "scalar", "domain": "\\{0,\\dots,\\min(m,n)\\}", "quantity_kind": "count", "dimension": "1", "si_unit": "1" },
        { "symbol": "n", "name": "矩阵列数（未知数个数）", "math_type": "constant", "domain": "\\mathbb{Z}^+", "quantity_kind": "count", "dimension": "1", "si_unit": "1" }
      ],
      "conditions": ["对任意 m×n 矩阵 A 恒成立；nullity(A) = dim(ker A) 即齐次方程 Ax = 0 的基础解系向量数"],
      "review": { "status": "human_verified", "source": "同济线性代数 4.4", "sympy_verified": true }
    },
    {
      "id": "linalg.mat.normal_eq",
      "name": "最小二乘正规方程",
      "aliases": ["普通最小二乘解析解（OLS）"],
      "latex": "A^\\top A \\hat{\\mathbf{x}} = A^\\top \\mathbf{b},\\quad \\hat{\\mathbf{x}} = (A^\\top A)^{-1} A^\\top \\mathbf{b}",
      "statement": "当超定方程 Ax = b 无精确解时，令残差 b - Ax 正交于 A 的列空间即可求得使误差平方和最小的唯一最优解。",
      "taxonomy": {
        "disciplines": ["mathematics", "statistics"],
        "education_stages": ["undergraduate"],
        "topics": ["matrices_systems"]
      },
      "variables": [
        { "symbol": "\\hat{\\mathbf{x}}", "name": "最小二乘估计解向量", "math_type": "vector", "domain": "\\mathbb{R}^n", "quantity_kind": null, "dimension": null, "si_unit": null }
      ],
      "conditions": ["显式求逆式要求 A 列满秩（rank(A) = n），从而 A^T A 对称正定可逆"],
      "review": { "status": "human_verified", "source": "Gilbert Strang 线性代数 4.3", "sympy_verified": true }
    },
    {
