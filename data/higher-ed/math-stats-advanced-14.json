  "formulas": [
    {
      "id": "stat.inf.chebyshev",
      "node_kind": "inequality",
      "name": "切比雪夫不等式",
      "aliases": [
        "尾部概率无分布上界"
      ],
      "latex": "P(|X - \\mu| \\ge \\varepsilon) \\le \\frac{\\sigma^2}{\\varepsilon^2}",
      "statement": "无需知道随机变量的具体分布形状，仅凭均值 μ 与有限方差 σ² 即可给出取值偏离均值超过 ε 的概率严格上界。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "undergraduate"
        ],
        "topics": [
          "statistical_inference"
        ]
      },
      "variables": [
        {
          "symbol": "\\varepsilon",
          "name": "偏离阈值",
          "math_type": "constant",
          "domain": "(0, +\\infty)",
          "quantity_kind": null,
          "dimension": null,
          "si_unit": null
        }
      ],
      "conditions": [
        "E(X) = μ 与 D(X) = σ² 存在且 ε > 0"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 5.1",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.inf.lln",
      "node_kind": "law",
      "name": "弱大数定律（辛钦大数定律）",
      "aliases": [
        "样本均值依概率收敛"
      ],
      "latex": "\\lim_{n \\to \\infty} P\\left(|\\bar{X}_n - \\mu| < \\varepsilon\\right) = 1\\quad (\\bar{X}_n \\xrightarrow{P} \\mu)",
      "statement": "随着独立同分布样本容量 n 无限增大，样本均值以概率 1 收敛于总体真实均值 μ，赋予了频率稳定性的理论保证。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "undergraduate"
        ],
        "topics": [
          "statistical_inference"
        ]
      },
      "variables": [
        {
          "symbol": "\\bar{X}_n",
          "name": "样本均值",
          "math_type": "scalar",
          "domain": "\\mathbb{R}",
          "quantity_kind": null,
          "dimension": null,
          "si_unit": null
        }
      ],
      "conditions": [
        "X1, ..., Xn 独立同分布且期望 μ 存在（切比雪夫版本额外要求方差 σ² 有限）"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 5.1",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.inf.sample_var",
      "node_kind": "formula",
      "name": "样本无偏方差公式（贝塞尔校正）",
      "aliases": [
        "自由度 n-1 样本方差"
      ],
      "latex": "S^2 = \\frac{1}{n - 1} \\sum_{i=1}^{n} (X_i - \\bar{X})^2",
      "statement": "用 n-1 而非 n 作为分母对样本离差平方和做自由度校正，从而保证样本方差的数学期望严格等于总体方差 E(S²) = σ²。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "undergraduate"
        ],
        "topics": [
          "statistical_inference"
        ]
      },
      "variables": [
        {
          "symbol": "S^2",
          "name": "样本无偏方差",
          "math_type": "scalar",
          "domain": "[0, +\\infty)",
          "quantity_kind": null,
          "dimension": null,
          "si_unit": null
        }
      ],
      "conditions": [
        "n ≥ 2；样本均值消耗了 1 个自由度，故自由度为 n - 1"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 6.1",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.dist.chi_square",
      "node_kind": "distribution",
      "name": "卡方分布（χ² 分布）",
      "aliases": [
        "独立标准正态平方和分布"
      ],
      "latex": "\\chi^2 = \\sum_{i=1}^{n} Z_i^2 \\sim \\chi^2(n),\\quad \\frac{(n-1)S^2}{\\sigma^2} \\sim \\chi^2(n - 1)",
      "statement": "n 个独立标准正态变量的平方和服从自由度为 n 的卡方分布，是正态总体方差抽样分布与拟合优度检验的核心。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "undergraduate"
        ],
        "topics": [
          "statistical_inference"
        ]
      },
      "variables": [
        {
          "symbol": "n",
          "name": "自由度（df）",
          "math_type": "constant",
          "domain": "\\mathbb{Z}^+",
          "quantity_kind": "count",
          "dimension": "1",
          "si_unit": "1"
        }
      ],
      "conditions": [
        "Z1,...,Zn 独立服从 N(0,1)；E(χ²) = n，D(χ²) = 2n"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 6.3",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.dist.t_dist",
      "node_kind": "distribution",
      "name": "学生 t 分布（Student's t）",
      "aliases": [
        "小样本均值抽样分布"
      ],
      "latex": "T = \\frac{Z}{\\sqrt{\\chi^2(n)/n}} \\sim t(n)",
      "statement": "标准正态变量除以独立卡方变量均方根构成的厚尾对称分布，用于总体方差未知时的均值区间估计与假设检验。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "undergraduate"
        ],
        "topics": [
          "statistical_inference"
        ]
      },
      "variables": [
        {
          "symbol": "T",
          "name": "t 统计量",
          "math_type": "scalar",
          "domain": "\\mathbb{R}",
          "quantity_kind": null,
          "dimension": null,
          "si_unit": null
        }
      ],
      "conditions": [
        "Z ~ N(0,1) 与 χ²(n) 相互独立；自由度 n 越大越逼近标准正态分布 N(0,1)"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 6.3",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.dist.f_dist",
      "node_kind": "distribution",
      "name": "费舍尔 F 分布",
      "aliases": [
        "两卡方比值分布 / 方差分析分布"
      ],
      "latex": "F = \\frac{\\chi^2(n_1)/n_1}{\\chi^2(n_2)/n_2} \\sim F(n_1, n_2)",
      "statement": "两个独立卡方变量各自除以自由度之比，是两总体方差齐性检验、方差分析（ANOVA）与回归整体显著性检验的核心。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "undergraduate"
        ],
        "topics": [
          "statistical_inference"
        ]
      },
      "variables": [
        {
          "symbol": "n_1, n_2",
          "name": "分子与分母自由度",
          "math_type": "constant",
          "domain": "\\mathbb{Z}^+",
          "quantity_kind": "count",
          "dimension": "1",
          "si_unit": "1"
        }
      ],
      "conditions": [
        "两卡方变量相互独立；若 T ~ t(n) 则 T² ~ F(1, n)"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 6.3",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.est.ci_z",
      "node_kind": "formula",
      "name": "总体均值 Z 置信区间（方差已知）",
      "aliases": [
