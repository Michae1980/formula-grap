  "formulas": [
    {
      "id": "stat.prob.classical",
      "node_kind": "formula",
      "name": "古典概型概率公式",
      "aliases": [
        "等可能概型公式"
      ],
      "latex": "P(A) = \\frac{m}{n}",
      "statement": "若样本空间包含 n 个等可能基本事件，事件 A 包含其中 m 个，则事件 A 发生的概率为 m/n。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "senior_high",
          "undergraduate"
        ],
        "topics": [
          "prob_basics"
        ]
      },
      "variables": [
        {
          "symbol": "P(A)",
          "name": "事件 A 的概率",
          "math_type": "scalar",
          "domain": "[0, 1]",
          "quantity_kind": "probability",
          "dimension": "1",
          "si_unit": "1"
        },
        {
          "symbol": "m, n",
          "name": "有利与总基本事件数",
          "math_type": "scalar",
          "domain": "\\mathbb{Z}^+",
          "quantity_kind": "count",
          "dimension": "1",
          "si_unit": "1"
        }
      ],
      "conditions": [
        "样本空间有限（n < ∞），且每个基本事件出现的可能性完全相等"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 1.3",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.prob.addition",
      "node_kind": "formula",
      "name": "概率加法公式（容斥原理）",
      "aliases": [
        "两事件并集概率公式"
      ],
      "latex": "P(A \\cup B) = P(A) + P(B) - P(AB)",
      "statement": "两个事件至少发生其一的概率，等于两事件各自概率之和减去它们同时发生的概率。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "senior_high",
          "undergraduate"
        ],
        "topics": [
          "prob_basics"
        ]
      },
      "variables": [
        {
          "symbol": "A, B",
          "name": "随机事件",
          "math_type": "set",
          "domain": "\\Omega",
          "quantity_kind": null,
          "dimension": null,
          "si_unit": null
        }
      ],
      "conditions": [
        "对任意两事件均成立；当 A、B 互斥（AB = ∅）时退化为 P(A∪B) = P(A) + P(B)"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 1.2",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.prob.conditional",
      "node_kind": "definition",
      "name": "条件概率公式",
      "aliases": [
        "条件概率定义式"
      ],
      "latex": "P(B \\mid A) = \\frac{P(AB)}{P(A)}",
      "statement": "在已知事件 A 发生的条件下，事件 B 发生的概率等于两者同时发生的概率除以事件 A 发生的概率。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "senior_high",
          "undergraduate"
        ],
        "topics": [
          "prob_basics"
        ]
      },
      "variables": [
        {
          "symbol": "P(B \\mid A)",
          "name": "A 条件下 B 的概率",
          "math_type": "scalar",
          "domain": "[0, 1]",
          "quantity_kind": "probability",
          "dimension": "1",
          "si_unit": "1"
        }
      ],
      "conditions": [
        "必须满足 P(A) > 0"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 1.4",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.prob.multiplication",
      "node_kind": "formula",
      "name": "概率乘法公式",
      "aliases": [
        "联合概率分解式"
      ],
      "latex": "P(AB) = P(A) P(B \\mid A)",
      "statement": "两事件同时发生的联合概率等于事件 A 发生的概率乘以在 A 发生条件下 B 发生的条件概率。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "senior_high",
          "undergraduate"
        ],
        "topics": [
          "prob_basics"
        ]
      },
      "variables": [
        {
          "symbol": "P(AB)",
          "name": "联合概率",
          "math_type": "scalar",
          "domain": "[0, 1]",
          "quantity_kind": "probability",
          "dimension": "1",
          "si_unit": "1"
        }
      ],
      "conditions": [
        "P(A) > 0；多事件可递推展开为链式乘法公式"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 1.4",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.prob.independence",
      "node_kind": "definition",
      "name": "事件独立性判定式",
      "aliases": [
        "相互独立事件公式"
      ],
      "latex": "P(AB) = P(A) P(B)",
      "statement": "若事件 A 是否发生不影响事件 B 发生的概率，则两事件相互独立，联合概率等于边缘概率之积。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "senior_high",
          "undergraduate"
        ],
        "topics": [
          "bayes_inference"
        ]
      },
      "variables": [
        {
          "symbol": "A, B",
          "name": "相互独立事件",
          "math_type": "set",
          "domain": "\\Omega",
          "quantity_kind": null,
          "dimension": null,
          "si_unit": null
        }
      ],
      "conditions": [
        "注意区分独立与互斥：两个正概率事件若互斥则必然不独立"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 1.5",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.prob.total_probability",
      "node_kind": "formula",
      "name": "全概率公式",
      "aliases": [
        "完备事件组概率展开"
      ],
      "latex": "P(B) = \\sum_{i=1}^{n} P(A_i) P(B \\mid A_i)",
      "statement": "将样本空间划分为两两互斥且完备的若干原因事件 Ai，结果事件 B 的总概率等于各路径概率之和。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "senior_high",
          "undergraduate"
        ],
        "topics": [
          "bayes_inference"
        ]
      },
      "variables": [
        {
          "symbol": "A_i",
          "name": "完备事件组（划分）",
          "math_type": "set",
          "domain": "\\Omega",
          "quantity_kind": null,
          "dimension": null,
          "si_unit": null
        }
      ],
      "conditions": [
        "A1, ..., An 两两互斥、并集为全空间 Ω，且 P(Ai) > 0"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 1.4",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.prob.bayes",
      "node_kind": "formula",
      "name": "贝叶斯公式",
      "aliases": [
        "后验概率更新公式"
      ],
      "latex": "P(A_k \\mid B) = \\frac{P(A_k) P(B \\mid A_k)}{\\sum_{i=1}^{n} P(A_i) P(B \\mid A_i)}",
      "statement": "在观测到结果 B 后，将原因 Ak 的先验概率结合似然度更新为后验概率，是统计推断与机器学习的基石。",
      "taxonomy": {
        "disciplines": [
          "mathematics",
          "statistics"
        ],
        "education_stages": [
          "senior_high",
          "undergraduate"
        ],
        "topics": [
          "bayes_inference"
        ]
      },
      "variables": [
        {
          "symbol": "P(A_k \\mid B)",
          "name": "后验概率",
          "math_type": "scalar",
          "domain": "[0, 1]",
          "quantity_kind": "probability",
          "dimension": "1",
          "si_unit": "1"
        },
        {
          "symbol": "P(A_k)",
          "name": "先验概率",
          "math_type": "scalar",
          "domain": "(0, 1]",
          "quantity_kind": "probability",
          "dimension": "1",
          "si_unit": "1"
        }
      ],
      "conditions": [
        "A1, ..., An 为样本空间划分，P(Ai) > 0 且 P(B) > 0"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 1.4",
        "sympy_verified": true
      }
    },
    {
      "id": "stat.rv.expectation_discrete",
      "node_kind": "definition",
