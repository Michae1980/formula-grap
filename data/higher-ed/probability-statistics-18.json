        ],
        "topics": [
          "expectation_variance"
        ]
      },
      "variables": [
        {
          "symbol": "\\rho_{XY}",
          "name": "相关系数",
          "math_type": "scalar",
          "domain": "[-1, 1]",
          "quantity_kind": "correlation",
          "dimension": "1",
          "si_unit": "1"
        }
      ],
      "conditions": [
        "D(X) > 0 且 D(Y) > 0；|ρ| = 1 当且仅当两变量几乎必然线性相关"
      ],
      "review": {
        "status": "human_verified",
        "source": "概率论与数理统计 4.3",
        "sympy_verified": true
      }
    },
