      "review": { "status": "human_verified", "source": "同济高等数学下册 9.2", "sympy_verified": true }
    },
    {
      "id": "calc.multi.total_diff",
      "name": "多元函数全微分公式",
      "aliases": ["切平面线性近似"],
      "latex": "dz = \\frac{\\partial z}{\\partial x}\\,dx + \\frac{\\partial z}{\\partial y}\\,dy",
      "statement": "可微二元函数的总增量线性主部等于各偏导数与对应自变量微分乘积之和，几何上对应曲面在该点的切平面。",
